<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Kapitel 20: Wächter als Vordergrunddienst mit Benachrichtigungen -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".OhApp"
        android:label="Zuhause"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Kapitel 20: Home-Screen-Widget -->
        <receiver
            android:name=".widget.LichtWidgetEmpfaenger"
            android:exported="true"
            android:label="Deckenlicht">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/licht_widget" />
        </receiver>

        <!-- Kapitel 20: Kachel in den Schnelleinstellungen -->
        <service
            android:name=".kachel.LichtKachel"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_view"
            android:label="Deckenlicht"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Kapitel 20: der Wächter -->
        <service
            android:name=".waechter.Waechter"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Smart-Home-Ereignisse von openHAB empfangen" />
        </service>
    </application>
</manifest>
